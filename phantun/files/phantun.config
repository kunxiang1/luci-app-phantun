# Phantun (https://github.com/dndx/phantun)
# Option names mirror the upstream command line flags one-to-one.
#
# Client: listens for UDP on 'local', connects to Phantun Server on 'remote'.
# Server: listens for fake-TCP on 'local' (port only), forwards UDP to 'remote'.

config global 'global'
	# placeholder section, rendered by the LuCI status tab

config client 'client1'
	option enabled '0'
	option local '0.0.0.0:1234'
	option remote '198.51.100.1:4567'
	option tun 'phantun0'
	option tun_local '192.168.200.1'
	option tun_peer '192.168.200.2'
	option ipv4_only '0'
	option tun_local6 'fcc8::1'
	option tun_peer6 'fcc8::2'
	#option handshake_packet '/etc/phantun/handshake.bin'
	option loglevel 'info'
	# automatically insert/remove the required nftables (fw4) rules
	option firewall '1'
	option network 'wan'

config server 'server1'
	option enabled '0'
	option local '4567'
	option remote '127.0.0.1:1234'
	option tun 'phantun1'
	option tun_local '192.168.201.1'
	option tun_peer '192.168.201.2'
	option ipv4_only '0'
	option tun_local6 'fcc9::1'
	option tun_peer6 'fcc9::2'
	#option handshake_packet '/etc/phantun/handshake.bin'
	option loglevel 'info'
	option firewall '1'
	option network 'wan'
